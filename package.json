{
  "name": "family-running",
  "version": "0.0.0",
  "private": true,
  "description": "Static GitHub Pages site for the Family Running Championships.",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "preview": "node scripts/serve-site.mjs",
    "preview:build": "node scripts/build-preview-artifact.mjs",
    "build:site": "node scripts/build-preview-artifact.mjs",
    "test": "node scripts/run-all-tests.mjs",
    "validate:safety": "node scripts/validate-repository-safety.mjs",
    "validate:csv": "node scripts/validate-csv.mjs",
    "validate:vendor": "node scripts/sync-vendor.mjs --check",
    "validate:gallery": "node scripts/validate-gallery.mjs",
    "validate:gallery-admin-catalog": "node scripts/build-gallery-admin-catalog.mjs --check",
    "vendor:sync": "node scripts/sync-vendor.mjs",
    "gallery-admin:catalog": "node scripts/build-gallery-admin-catalog.mjs",
    "test:export-bundle": "node tests/export-bundle-validation.mjs",
    "test:age-grade-contract": "node tests/age-grade-contract.mjs",
    "test:gallery-contract": "node tests/gallery-contract.mjs",
    "test:gallery-upload-contract": "node tests/gallery-upload-contract.mjs",
    "test:gallery-media-policy": "node tests/gallery-media-policy.mjs",
    "test:gallery-media-processor": "node tests/gallery-media-processor.mjs",
    "test:gallery-processing-bridge": "node tests/gallery-processing-bridge.mjs",
    "test:gallery-photo-promotion-worker": "node tests/gallery-photo-promotion-worker.mjs",
    "test:gallery-photo-promotion-config": "node tests/gallery-photo-promotion-config.mjs",
    "test:gallery-media-delivery-contract": "node tests/gallery-media-delivery-contract.mjs",
    "test:gallery-public-host-migration": "node tests/gallery-public-host-migration.mjs",
    "test:gallery-public-host-verifier": "node tests/gallery-public-host-verifier.mjs",
    "test:gallery-public-host-remote-rehearsal": "node tests/gallery-public-host-remote-rehearsal.mjs",
    "test:gallery-public-host-remote-sqlite-integration": "node tests/gallery-public-host-remote-sqlite-integration.mjs",
    "test:gallery-approved-media-lifecycle": "node tests/gallery-approved-media-lifecycle.mjs",
    "test:gallery-manifest-candidate": "node tests/gallery-manifest-candidate.mjs",
    "test:gallery-github-review-client": "node tests/gallery-github-review-client.mjs",
    "test:gallery-processing-rehearsal-worker": "node tests/gallery-processing-rehearsal-worker.mjs",
    "test:gallery-phase-d-migration-configs": "node tests/gallery-phase-d-migration-configs.mjs",
    "test:gallery-phase-d-processing-configs": "node tests/gallery-phase-d-processing-configs.mjs",
    "test:gallery-phase-d-remote-rehearsal": "node tests/gallery-phase-d-remote-rehearsal.mjs",
    "test:gallery-storage-keys": "node tests/gallery-storage-keys.mjs",
    "test:gallery-admin-boundaries": "node tests/gallery-admin-boundaries.mjs",
    "test:gallery-admin-catalog": "node tests/gallery-admin-catalog.mjs",
    "test:gallery-admin-phase-c": "node tests/gallery-admin-phase-c.mjs",
    "test:gallery-admin-browser": "node tests/gallery-admin-browser.mjs",
    "test:staged-export": "node tests/staged-export-workflow.mjs",
    "test:artifact-safety": "node tests/preview-artifact-safety.mjs",
    "test:personal-best-reconciliation": "node tests/personal-best-reconciliation.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "screenshots:update": "node tests/browser-smoke.mjs --update-screenshots",
    "reconcile:personal-bests": "node scripts/reconcile-personal-bests.mjs",
    "data:update": "node scripts/simple-data-update.mjs",
    "workbook:check:contract": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-workbook-staged-export.ps1 -PreflightOnly",
    "workbook:export:staged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-workbook-staged-export.ps1",
    "workbook:validate:staged": "node scripts/export-bundle-validation.mjs",
    "workbook:compare:staged": "node scripts/compare-export-bundle.mjs",
    "workbook:promote:staged": "node scripts/promote-staged-export.mjs"
  },
  "devDependencies": {
    "chart.js": "4.5.0",
    "chartjs-adapter-date-fns": "3.0.0",
    "date-fns": "4.1.0",
    "exiftool-vendored": "31.2.0",
    "playwright": "^1.61.0",
    "sharp": "0.35.2",
    "wrangler": "4.126.0"
  }
}
