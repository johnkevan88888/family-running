# Auto detect text files and perform LF normalization
* text=auto

# The generated Gallery catalog is compared byte-for-byte with LF-rendered
# output on every platform, so Windows checkouts must not rewrite it to CRLF.
gallery-admin/generated/catalog-snapshot.js text eol=lf

# Vendored library builds must round-trip byte for byte. Without this, checkout
# on Windows rewrites them to CRLF and `pnpm run validate:vendor` reports drift
# against the identical build in node_modules.
vendor/** -text
